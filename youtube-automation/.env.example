# Copy to .env and fill in only the providers you actually use.
# The pipeline runs fully offline with the defaults (stub LLM + piper voice),
# so you can render sample videos with NONE of these set.

# ── Script generation (config: providers.llm) ─────────────────────────────
# provider "gemini"  -> free tier available at aistudio.google.com
GEMINI_API_KEY=
# provider "anthropic"
ANTHROPIC_API_KEY=

# ── Voiceover (config: providers.voice) ───────────────────────────────────
# provider "openai"  -> ~$15 / 1M chars, natural
OPENAI_API_KEY=
# provider "elevenlabs" -> best quality, reserve for hero videos
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ── Optional overrides ────────────────────────────────────────────────────
# FFMPEG_BIN=/usr/bin/ffmpeg
# PIPER_VOICE=assets/voices/en-us-ryan-high.onnx
